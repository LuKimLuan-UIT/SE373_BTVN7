OPENAI_API_KEY=
MODEL_NAME=
OPENAI_BASE_URL=

# Người dùng hiện tại — namespace của long-term memory (mỗi user một namespace riêng)
USER_ID=default-user

# Tầng 2: long-term memory (facts xuyên session)
MEMORY_LONG_TERM=1

# Tầng 3: tóm tắt lịch sử khi session dài
MEMORY_SUMMARIZATION=1
MEMORY_SUMMARY_TRIGGER=12
MEMORY_SUMMARY_KEEP=6

# Vị trí đặt memory index:
#   system = cuối system prompt (an toàn, mọi provider)
#   end    = cuối hội thoại (giữ prompt cache cho cả lịch sử khi memory đổi)
MEMORY_PLACEMENT=system

# Giới hạn số lần gọi model trong 1 lượt chat
MODEL_CALL_LIMIT=8
