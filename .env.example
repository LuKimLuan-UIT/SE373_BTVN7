OPENAI_API_KEY=
MODEL_NAME=
OPENAI_BASE_URL=

# Người dùng hiện tại — mỗi user một thư mục memory riêng (data/memory/<USER_ID>/)
USER_ID=default-user

# Tầng 2: memory dài hạn (quyết định của người dùng, xuyên nhiều session)
#   1 = bật tool remember/recall/update/supersede/forget + nạp index MEMORY.md
#   0 = không có memory dài hạn, mỗi session độc lập
MEMORY_LONG_TERM=1

# Vị trí đặt memory index:
#   system = cuối system prompt (an toàn, mọi provider)
#   end    = cuối hội thoại (giữ prompt cache cho cả lịch sử khi memory đổi)
MEMORY_PLACEMENT=end

# Giới hạn số lần gọi model trong 1 lượt chat (chặn vòng lặp vô hạn)
MODEL_CALL_LIMIT=8
